# ── Required ─────────────────────────────────────────────────────
# Public URL(s) of the app: full addresses, comma-separated. Cookie-authenticated writes are
# only accepted from these origins. The first one decides: https:// enables Secure cookies + HSTS.
# In development with Vite use: http://localhost:5173,http://localhost:3000
APP_URL=http://localhost:3000

# Claims this copy the first time you open it: at least 12 letters A–Z or digits
# (other characters don't count).
# If unset, a one-off code is generated and printed in the server log.
# Changing it later lets you recover access if you lose the access key.
# SETUP_CODE=

# ── Optional ─────────────────────────────────────────────────────
# ORQEVIO_VERSION=latest      # Docker image tag to run (for example 1.0.0)
# PORT=3000                   # with Docker Compose, the port on your machine (the container listens on 3000)
# BACKUP_DIR=                 # daily backups, the last 7; defaults to DATA_DIR/backups (better on another disk)
# BACKUPS=off                 # no daily backups
# MAX_UPLOAD_MB=20
# TRUST_PROXY=false           # true behind a reverse proxy, or how many there are in front (such as 2)
# SECURE_COOKIES=             # defaults to true when APP_URL starts with https://
# UPDATE_CHECK=on             # off: never ask registry.npmjs.org for the latest version

# From source only (Docker listens on 0.0.0.0 and keeps the data in the orqevio-data volume):
# HOST=0.0.0.0
# DATA_DIR=./data             # SQLite database (orqevio.db) and attachments (uploads/)
# DATABASE_PATH=              # defaults to DATA_DIR/orqevio.db
