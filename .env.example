# ── Required ─────────────────────────────────────────────────────
# Public URL(s) of the app, comma-separated. Cookie-authenticated writes are only accepted
# from these origins, and https:// enables Secure cookies + HSTS automatically.
# In development with Vite use: http://localhost:5173,http://localhost:3000
APP_URL=http://localhost:3000

# Claims this copy the first time you open it (at least 12 letters or digits).
# If unset, a one-off code is generated and printed in the server log.
# Changing it later lets you recover access if you lose the access key.
# SETUP_CODE=

# ── Optional ─────────────────────────────────────────────────────
# ORQEVIO_VERSION=latest      # Docker image tag to run (for example 0.1.0)
# PORT=3000
# HOST=0.0.0.0
# DATA_DIR=./data             # SQLite database (orqevio.db) and attachments (uploads/)
# DATABASE_PATH=              # defaults to DATA_DIR/orqevio.db
# MAX_UPLOAD_MB=20
# TRUST_PROXY=false           # set true behind a reverse proxy that sets X-Forwarded-For
# SECURE_COOKIES=             # defaults to true when APP_URL starts with https://
