{
  "name": "@orqevio/server",
  "version": "1.0.0-rc.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "dev:worker": "wrangler dev --local",
    "build": "node build.mjs",
    "start": "node dist/index.js",
    "cli": "node --env-file-if-exists=../../.env dist/cli.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "check:worker": "wrangler deploy --dry-run --outdir dist-worker",
    "db:generate": "drizzle-kit generate && node scripts/migrations-module.mjs",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate-cli.ts",
    "admin": "tsx --env-file-if-exists=../../.env src/cli.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@orqevio/shared": "workspace:*",
    "better-sqlite3": "13.1.1",
    "drizzle-orm": "0.45.4",
    "fractional-indexing": "4.0.0",
    "hono": "4.13.16",
    "ws": "8.22.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261112.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^22.20.5",
    "@types/ws": "8.18.2",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "wrangler": "4.161.0"
  }
}
